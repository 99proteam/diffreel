{
  "name": "diffreel",
  "version": "0.1.0",
  "description": "Turn code changes into smooth animated videos (MP4, WebM, GIF) for tutorials, YouTube, reels and social posts.",
  "keywords": [
    "code-animation",
    "code-to-video",
    "code-video",
    "diff",
    "animation",
    "video",
    "video-generation",
    "mp4",
    "gif",
    "webm",
    "shiki",
    "syntax-highlighting",
    "magic-move",
    "playwright",
    "ffmpeg",
    "cli",
    "typescript",
    "developer-tools",
    "tutorial",
    "youtube",
    "reels",
    "shorts",
    "tiktok",
    "screencast",
    "git"
  ],
  "homepage": "https://github.com/99proteam/diffreel#readme",
  "bugs": {
    "url": "https://github.com/99proteam/diffreel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99proteam/diffreel.git"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/99proteam"
  },
  "license": "MIT",
  "author": "99proteam",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "diffreel": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/e2e.test.ts",
    "test:watch": "vitest",
    "examples": "npm run build && node scripts/render-examples.mjs",
    "browsers": "playwright install chromium",
    "prepublishOnly": "npm run build",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/build-site.mjs && npx --yes serve site-dist -l 4173"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "commander": "^14.0.0",
    "diff": "^9.0.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.12.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^16.0.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
